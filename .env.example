# Copy to .env for local dev, or export these in CI/automation.
# Precedence: command flags > these env vars > settings file / keychain > defaults.

# n8n API key (n8n: Settings > n8n API). Interactively, prefer `n8nctl login`
# (stored in the OS keychain). In CI and for agents, set this instead.
N8NCTL_API_KEY=

# The n8n address. There is no default: n8n runs wherever you host it.
# N8NCTL_BASE_URL=https://n8n.example.com

# Your own n8n sign-in, for the three commands the API key cannot do: archive,
# unarchive and run. Interactively, prefer `n8nctl login --email`.
# N8NCTL_EMAIL=you@example.com
# N8NCTL_PASSWORD=

# Milliseconds to wait between requests to n8n (defaults to 0). Set it for an n8n that
# falls over under fast calls; `config set delayMs 1000` keeps it for every run.
# N8NCTL_DELAY_MS=1000

# Folder for download, backup, diff and `list --local` (defaults to ./workflows).
# N8NCTL_WORKFLOWS_DIR=./workflows

# Named account (defaults to "default").
# N8NCTL_ACCOUNT=default

# Refuse every command that would change remote data. The safe choice for agents
# and automation. Set to 0 to let one run write when the settings file says
# "readOnly": true.
# N8NCTL_READ_ONLY=1

# Use this settings file instead of the default one (`n8nctl config path`).
# N8NCTL_CLI_CONFIG_FILE=./n8nctl-config.json

# The settings folder follows the platform: XDG_CONFIG_HOME where it is set, and
# APPDATA on Windows.

# Pick the credential store instead of keychain-then-file. "memory" keeps the key
# for one process only, and tests set it so they can never touch real credentials.
# "file" always uses the private credentials file.
# N8NCTL_CLI_CREDENTIAL_STORE=memory

# Where the key is kept when the OS keychain is closed (as over SSH on macOS).
# N8NCTL_CLI_CREDENTIALS_FILE=./credentials.json

# Stop `n8nctl login` opening a browser. Set suite-wide in vitest.config.ts,
# and useful on a headless machine where the browser has nowhere to open.
# N8NCTL_CLI_NO_BROWSER=1
